# Public site URL used for canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://manwithamav.ca

# Digits only, country code first. Used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=12899070169

# E.164 number for sms: and tel: links, plus the number shown on the site.
NEXT_PUBLIC_PHONE_NUMBER=+12899070169
NEXT_PUBLIC_PHONE_DISPLAY=(289) 907-0169

NEXT_PUBLIC_EMAIL=hello@manwithamav.ca

# Server-only. Enable Routes API and Places API (New) on this key.
# Restrict it by IP or to your server. Do not prefix it with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Server-only shared secret for /owner/calculator.
# Leave unset in production to keep that route disabled (404).
OWNER_ACCESS_SECRET=
